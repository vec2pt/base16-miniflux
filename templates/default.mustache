  --modal-box-shadow: 2px 0 5px 0 var(--base04);
  --pagination-link-color: var(--base0D);
  --pagination-border-color: var(--base04);
  --category-color: var(--base05);
  --category-background-color: var(--base01);
  --category-border-color: var(--base04);
